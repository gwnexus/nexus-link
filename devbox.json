{
  "env": {
    "RUSTC_WRAPPER": "sccache",
    "RUST_BACKTRACE": "1",
    "CARGO_TERM_COLOR": "always",
    "CARGO_INCREMENTAL": "0",
    "NEXT_TELEMETRY_DISABLED": "1",
    "POWERLEVEL9K_INSTANT_PROMPT": "quiet",
    "C_DBX_META_TEAM": "NEXUS-Labs",
    "C_DBX_META_TEAM_ID": "NEXUS-Labs-DD",
    "C_DBX_META_PROJECT_ID": "NEXUS-LINK",
    "C_DBX_META_TEAM_DESCRIPTION": "Nexus SaaS Development Team"
  },
  "shell": {
    "scripts": {
      "dev": [
        "cargo build"
      ],
      "test": [
        "cargo nextest run --all"
      ],
      "audit": [
        "cargo audit || true",
        "cargo deny check || true"
      ],
      "check": [
        "cargo fmt --all",
        "cargo clippy --all -- -D warnings"
      ],
      "sec-scan": [
        "bash scripts/devbox/ops/sec-scan.sh"
      ],
      "validate": [
        "bash scripts/devbox/ops/validate.sh"
      ],
      "check-local": [
        "bash scripts/devbox/ops/check-local.sh"
      ]
    },
    "init_hook": [
      "_penv=\"${DEVBOX_PROJECT_ROOT:-.}/.nexus/plugin.env\"; if [ -f \"$_penv\" ]; then if grep -qF '# Sourced by the devbox init hook' \"$_penv\"; then set -a; . \"$_penv\"; set +a; else echo \"plugin.env not loaded: written by an older nexus CLI; run nexus upgrade, then nexus pull\" >&2; fi; fi; unset _penv",
      "scripts/devbox/dbx_init.sh"
    ]
  },
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.1/.schema/devbox.schema.json",
  "packages": {
    "fd": "latest",
    "jq": "latest",
    "bat": "0.24.0",
    "fzf": "0.54.0",
    "git": "latest",
    "glow": "1.5.1",
    "rustup": "latest",
    "sqlite": "latest",
    "lazygit": "0.43.1",
    "ripgrep": "14.1.0",
    "sccache": "latest",
    "gitleaks": "8.30.1",
    "git-cliff": "latest",
    "cargo-deny": "latest",
    "commitizen": "3.29.1",
    "pre-commit": "3.7.1",
    "cargo-audit": "latest",
    "cargo-nextest": "latest",
    "rust-analyzer": "latest",
    "zellij": "0.45.0",
    "ccusage": "20.0.17",
    "nodejs_22": "latest"
  }
}
