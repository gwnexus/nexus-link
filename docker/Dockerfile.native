# Native aarch64 build (for building directly on Spark or ARM CI)
# No cross-compilation needed -- builds natively on ARM64

# Rust version: keep in sync with rust-toolchain.toml (single source of
# truth); scripts/ci/check-rust-version.sh enforces it in CI.
ARG RUST_VERSION=1.100.0

FROM rust:${RUST_VERSION}-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Cache dependencies
COPY Cargo.toml Cargo.lock ./
COPY crates/nexus-link-core/Cargo.toml crates/nexus-link-core/
COPY crates/nexus-link-cli/Cargo.toml crates/nexus-link-cli/
COPY crates/nexus-link-agent/Cargo.toml crates/nexus-link-agent/
COPY crates/nexus-link-service/Cargo.toml crates/nexus-link-service/
COPY tests/Cargo.toml tests/

# Create dummy sources for dependency caching
RUN mkdir -p crates/nexus-link-core/src crates/nexus-link-cli/src \
        crates/nexus-link-agent/src crates/nexus-link-service/src tests/src \
    && echo "pub fn placeholder() {}" > crates/nexus-link-core/src/lib.rs \
    && echo "fn main() {}" > crates/nexus-link-cli/src/main.rs \
    && echo "fn main() {}" > crates/nexus-link-agent/src/main.rs \
    && echo "fn main() {}" > crates/nexus-link-service/src/main.rs \
    && echo "" > tests/src/lib.rs

# Build dependencies only
RUN cargo build --release -p nexus-link-service 2>/dev/null || true

# Copy real source
COPY crates/ crates/
COPY tests/ tests/

# Build all binaries (service + agent + cli); touch sources first so
# cargo rebuilds them over the cached dummy crates
RUN find crates tests -name "*.rs" -exec touch {} + \
    && cargo build --release

# --- Runtime stage ---
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -s /bin/false nexus-link

COPY --from=builder /build/target/release/nexus-link-service /usr/local/bin/
COPY --from=builder /build/target/release/nexus-link-agent /usr/local/bin/
COPY --from=builder /build/target/release/nexus-link /usr/local/bin/

USER nexus-link

EXPOSE 8443

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8443/api/health || exit 1

ENTRYPOINT ["nexus-link-service"]
